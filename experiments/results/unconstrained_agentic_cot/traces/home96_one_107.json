      "format": "python_code_unconstrained",
      "content": "class DecreaseVolume(py_trees.behaviour.Behaviour):\n    def __init__(self, name, current_volume_url, set_volume_url, decrease_percentage):\n        super().__init__(name)\n        self.current_volume_url = current_volume_url\n        self.set_volume_url = set_volume_url\n        self.decrease_percentage = decrease_percentage\n\n    def update(self):\n        try:\n            # Get the current volume\n            response = http_client.get(self.current_volume_url)\n            if response.status_code != 200:\n                return Status.FAILURE\n\n            current_volume = response.json()\n            # Calculate the new volume\n            decrease_amount = current_volume * (self.decrease_percentage / 100.0)\n            new_volume = int(current_volume - decrease_amount)\n\n            # Ensure the new volume is within valid range\n            if new_volume < 0:\n                new_volume = 0\n            elif new_volume > 100:\n                new_volume = 100\n\n            # Set the new volume\n            response = http_client.post(self.set_volume_url, json={\"volume\": new_volume})\n            if response.status_code == 200:\n                return Status.SUCCESS\n            else:\n                return Status.FAILURE\n\n        except Exception:\n            return Status.FAILURE\n\n# Create the behavior tree\nvolume_url = \"http://localhost:8080/workspaces/home96/master_bedroom/artifacts/masterBedroomMediaPlayer/properties/volume\"\nset_volume_url = \"http://localhost:8080/workspaces/home96/master_bedroom/artifacts/masterBedroomMediaPlayer/set_volume\"\ntree = DecreaseVolume(\"Decrease Volume by 44%\", volume_url, set_volume_url, 44)",
