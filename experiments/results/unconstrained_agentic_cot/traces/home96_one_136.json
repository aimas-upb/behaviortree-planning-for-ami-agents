      "content": "class SetTemperature(py_trees.behaviour.Behaviour):\n    def __init__(self, name, temperature_url, action_url, target_temperature):\n        super().__init__(name)\n        self.temperature_url = temperature_url\n        self.action_url = action_url\n        self.target_temperature = target_temperature\n\n    def update(self):\n        try:\n            # Check current temperature\n            response = http_client.get(self.temperature_url)\n            if response.status_code == 200:\n                current_temperature = response.json()\n                if current_temperature == self.target_temperature:\n                    return Status.SUCCESS\n\n            # Set the temperature\n            response = http_client.post(self.action_url, json={\"temperature\": self.target_temperature})\n            return Status.SUCCESS if response.status_code == 200 else Status.FAILURE\n        except Exception:\n            return Status.FAILURE\n\n# Create the behavior tree\nset_temperature = SetTemperature(\n    name=\"Set Temperature to 21\",\n    temperature_url=\"http://localhost:8080/workspaces/home96/guest_bedroom/artifacts/guestBedroomAirConditioner/properties/temperature\",\n    action_url=\"http://localhost:8080/workspaces/home96/guest_bedroom/artifacts/guestBedroomAirConditioner/set_temperature\",\n    target_temperature=21\n)\n\n# Since the air conditioner is already on, we only need to set the temperature\ntree = py_trees.composites.Sequence(name=\"Set AC Temperature\", memory=True, children=[set_temperature])",
