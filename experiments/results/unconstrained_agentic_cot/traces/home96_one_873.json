      "content": "class DecreaseIntensity(py_trees.behaviour.Behaviour):\n    def __init__(self, name, current_intensity_url, set_intensity_url, decrease_by_percent):\n        super().__init__(name)\n        self.current_intensity_url = current_intensity_url\n        self.set_intensity_url = set_intensity_url\n        self.decrease_by_percent = decrease_by_percent\n\n    def update(self):\n        try:\n            # Get the current intensity\n            response = http_client.get(self.current_intensity_url)\n            if response.status_code != 200:\n                return Status.FAILURE\n\n            current_intensity = response.json()\n            # Calculate the new intensity\n            new_intensity = max(0, current_intensity - int(current_intensity * self.decrease_by_percent / 100))\n\n            # Set the new intensity\n            response = http_client.post(self.set_intensity_url, json={\"intensity\": new_intensity})\n            if response.status_code == 200:\n                return Status.SUCCESS\n            else:\n                return Status.FAILURE\n        except Exception:\n            return Status.FAILURE\n\n# Define the behavior tree\nintensity_url = \"http://localhost:8080/workspaces/home96/master_bedroom/artifacts/masterBedroomDehumidifiers/properties/intensity\"\nset_intensity_url = \"http://localhost:8080/workspaces/home96/master_bedroom/artifacts/masterBedroomDehumidifiers/set_intensity\"\ndecrease_intensity = DecreaseIntensity(\"Decrease Intensity by 20%\", intensity_url, set_intensity_url, 20)\n\n# Create the root of the tree\nroot = py_trees.composites.Sequence(name=\"Root Sequence\", memory=True, children=[decrease_intensity])\n\ntree = root",
